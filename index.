// ---------- Jamo-level pronunciation diff (which exact sound to fix) ----------
// Foreign-learner feedback request: instead of a vague "syllable 3 was off",
// point at exactly which jamo (consonant/vowel) differed and what to change
// it to — e.g. "3rd syllable: change 'ㅣ(i)' to 'ㅏ(a)'" for 돌려차기 heard
// as 돌려치기.
const ROMAN_CHO = { 'ㄱ':'g','ㄲ':'kk','ㄴ':'n','ㄷ':'d','ㄸ':'tt','ㄹ':'r','ㅁ':'m','ㅂ':'b','ㅃ':'pp','ㅅ':'s','ㅆ':'ss','ㅇ':'(silent)','ㅈ':'j','ㅉ':'jj','ㅊ':'ch','ㅋ':'k','ㅌ':'t','ㅍ':'p','ㅎ':'h' };
const ROMAN_JUNG = { 'ㅏ':'a','ㅐ':'ae','ㅑ':'ya','ㅒ':'yae','ㅓ':'eo','ㅔ':'e','ㅕ':'yeo','ㅖ':'ye','ㅗ':'o','ㅘ':'wa','ㅙ':'wae','ㅚ':'oe','ㅛ':'yo','ㅜ':'u','ㅝ':'wo','ㅞ':'we','ㅟ':'wi','ㅠ':'yu','ㅡ':'eu','ㅢ':'ui','ㅣ':'i' };
const ROMAN_JONG = { '':'(none)','ㄱ':'k','ㄲ':'k','ㄳ':'k','ㄴ':'n','ㄵ':'n','ㄶ':'n','ㄷ':'t','ㄹ':'l','ㄺ':'k','ㄻ':'m','ㄼ':'l','ㄽ':'l','ㄾ':'l','ㄿ':'p','ㅀ':'l','ㅁ':'m','ㅂ':'p','ㅄ':'p','ㅅ':'t','ㅆ':'t','ㅇ':'ng','ㅈ':'t','ㅊ':'t','ㅋ':'k','ㅌ':'t','ㅍ':'p','ㅎ':'t' };

const PART_LABEL = {
  ko: { cho: '첫 자음', jung: '모음', jong: '받침' },
  en: { cho: 'the starting consonant', jung: 'the vowel', jong: 'the final consonant (batchim)' },
  es: { cho: 'la consonante inicial', jung: 'la vocal', jong: 'la consonante final (batchim)' },
  fr: { cho: 'la consonne initiale', jung: 'la voyelle', jong: 'la consonne finale (batchim)' },
  zh: { cho: '声母（首字音）', jung: '元音', jong: '收音（받침）' },
  fa: { cho: 'همخوانِ آغازین', jung: 'واکه (مصوت)', jong: 'همخوانِ پایانی (batchim)' },
  ar: { cho: 'الحرف الساكن الأول', jung: 'حرف العلة', jong: 'الحرف الساكن الأخير (batchim)' }
};

function decomposeSyllable(ch) {
  const code = (ch || '').charCodeAt(0) - 0xAC00;
  if (code < 0 || code > 11171) return null;
  const choIdx = Math.floor(code / (21 * 28));
  const jungIdx = Math.floor((code % (21 * 28)) / 28);
  const jongIdx = code % 28;
  return { cho: CHO[choIdx], jung: JUNG[jungIdx], jong: JONG[jongIdx] };
}

// Aligns target vs. heard character-by-character (this app's terms are short,
// so position-based alignment is reliable) and reports, for every syllable
// that differs, exactly which jamo component(s) changed.
function detailedJamoDiff(target, heard) {
  const t = [...(target || '')];
  const h = [...(heard || '').replace(/\s+/g, '')];
  const len = Math.min(t.length, h.length);
  const diffs = [];
  for (let i = 0; i < len; i++) {
    if (t[i] === h[i]) continue;
    const ts = decomposeSyllable(t[i]);
    const hs = decomposeSyllable(h[i]);
    if (!ts || !hs) { diffs.push({ pos: i + 1, targetChar: t[i], heardChar: h[i], parts: [] }); continue; }
    const parts = [];
    if (ts.cho !== hs.cho) parts.push({ part: 'cho', target: ts.cho, heard: hs.cho, targetRoman: ROMAN_CHO[ts.cho], heardRoman: ROMAN_CHO[hs.cho] });
    if (ts.jung !== hs.jung) parts.push({ part: 'jung', target: ts.jung, heard: hs.jung, targetRoman: ROMAN_JUNG[ts.jung], heardRoman: ROMAN_JUNG[hs.jung] });
    if (ts.jong !== hs.jong) parts.push({ part: 'jong', target: ts.jong, heard: hs.jong, targetRoman: ROMAN_JONG[ts.jong], heardRoman: ROMAN_JONG[hs.jong] });
    diffs.push({ pos: i + 1, targetChar: t[i], heardChar: h[i], parts });
  }
  return diffs;
}

// Turns a detailedJamoDiff() result into one localized, human-readable
// coaching line per differing syllable (capped at 2 so it stays readable).
function buildJamoHint(lang, target, heard) {
  const labels = PART_LABEL[lang] || PART_LABEL.en;
  const diffs = detailedJamoDiff(target, heard).slice(0, 2);
  if (!diffs.length) return '';

  const lines = diffs.map(d => {
    if (!d.parts.length) {
      // whole syllable unrecognizable / non-Hangul — fall back to a plain mention
      const T = { ko: `${d.pos}번째 글자("${d.targetChar}")를 다시 확인해보세요.`,
                  en: `Take another look at syllable ${d.pos} ("${d.targetChar}").`,
                  es: `Revisa de nuevo la sílaba ${d.pos} ("${d.targetChar}").`,
                  fr: `Revérifiez la syllabe ${d.pos} (« ${d.targetChar} »).`,
                  zh: `请重新检查第${d.pos}个字（"${d.targetChar}"）。`,
                  fa: `هجای ${d.pos} («${d.targetChar}») را دوباره بررسی کن.`,
                  ar: `تحقق مرة أخرى من المقطع ${d.pos} ("${d.targetChar}").` };
      return T[lang] || T.en;
    }
    return d.parts.map(p => {
      const label = labels[p.part];
      const T = {
        ko: `${d.pos}번째 글자("${d.targetChar}")의 ${label}을(를) 고쳐보세요 — '${p.heard}(${p.heardRoman})' 발음을 '${p.target}(${p.targetRoman})' 발음으로 바꾸세요.`,
        en: `Fix syllable ${d.pos} ("${d.targetChar}") — ${label}: you said '${p.heard}(${p.heardRoman})', change it to '${p.target}(${p.targetRoman})'.`,
        es: `Corrige la sílaba ${d.pos} ("${d.targetChar}") — ${label}: dijiste '${p.heard}(${p.heardRoman})', cámbialo por '${p.target}(${p.targetRoman})'.`,
        fr: `Corrigez la syllabe ${d.pos} (« ${d.targetChar} ») — ${label} : vous avez dit « ${p.heard}(${p.heardRoman}) », changez-le en « ${p.target}(${p.targetRoman}) ».`,
        zh: `请修正第${d.pos}个字("${d.targetChar}")的${label}——你发的是'${p.heard}(${p.heardRoman})'，请改成'${p.target}(${p.targetRoman})'。`,
        fa: `هجای ${d.pos} («${d.targetChar}») را اصلاح کن — ${label}: تو '${p.heard}(${p.heardRoman})' گفتی، آن را به '${p.target}(${p.targetRoman})' تغییر بده.`,
        ar: `صحّح المقطع ${d.pos} ("${d.targetChar}") — ${label}: نطقت '${p.heard}(${p.heardRoman})'، غيّره إلى '${p.target}(${p.targetRoman})'.`
      };
      return T[lang] || T.en;
    }).join(' ');
  });

  return ' ' + lines.join(' ');
}

