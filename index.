  renderMicStatus();

  if (!hasAttempted) {
    document.getElementById('heardText').textContent = UI.notTried[currentLang];
    document.getElementById('feedbackBlock').innerHTML = `<span class="empty-note"><bdi>${UI.feedbackPlaceholder[currentLang]}</bdi></span>`;
  }
  updateScoreTag(lastScore, hasAttempted);
});

// ---------- Score meter ----------
function updateScore(score, attempted = true) {
  lastScore = score;
  hasAttempted = attempted;
  const circumference = 440;
  const offset = circumference - (circumference * score / 100);
  document.getElementById('ringProgress').style.strokeDashoffset = offset;
  document.getElementById('scoreNum').textContent = attempted ? score + '%' : '—';
  updateScoreTag(score, attempted);
}

function updateScoreTag(score, attempted) {
  const tagEl = document.getElementById('scoreTag');
  if (!attempted) tagEl.textContent = UI.tagInitial[currentLang];
  else tagEl.textContent = getScoreTierText(score, currentLang);
}

// ---------- Korean jamo (자모) decomposition & matching ----------
const CHO = ['ㄱ','ㄲ','ㄴ','ㄷ','ㄸ','ㄹ','ㅁ','ㅂ','ㅃ','ㅅ','ㅆ','ㅇ','ㅈ','ㅉ','ㅊ','ㅋ','ㅌ','ㅍ','ㅎ'];
const JUNG = ['ㅏ','ㅐ','ㅑ','ㅒ','ㅓ','ㅔ','ㅕ','ㅖ','ㅗ','ㅘ','ㅙ','ㅚ','ㅛ','ㅜ','ㅝ','ㅞ','ㅟ','ㅠ','ㅡ','ㅢ','ㅣ'];
const JONG = ['','ㄱ','ㄲ','ㄳ','ㄴ','ㄵ','ㄶ','ㄷ','ㄹ','ㄺ','ㄻ','ㄼ','ㄽ','ㄾ','ㄿ','ㅀ','ㅁ','ㅂ','ㅄ','ㅅ','ㅆ','ㅇ','ㅈ','ㅊ','ㅋ','ㅌ','ㅍ','ㅎ'];

// Returns {ch, isJong} objects rather than plain characters so that
// weightedJamoDistance can tell an initial/medial jamo apart from a final
// consonant (batchim) — needed because the same letter (e.g. 'ㄱ') means a
// different thing, and gets a different confusion cost, depending on
// whether it's a syllable's leading consonant or its trailing one.
function decomposeToJamo(str) {
  const jamoList = [];
  for (const ch of (str || '')) {
    const code = ch.charCodeAt(0) - 0xAC00;
    if (code < 0 || code > 11171) continue; 
    const cho = Math.floor(code / (21 * 28));
    const jung = Math.floor((code % (21 * 28)) / 28);
    const jong = code % 28;
    jamoList.push({ ch: CHO[cho], isJong: false });
    jamoList.push({ ch: JUNG[jung], isJong: false });
    if (jong !== 0) jamoList.push({ ch: JONG[jong], isJong: true });
  }
  return jamoList;
}

// Cleans up raw speech-recognition output before comparison: Unicode-
// normalizes it (composed Hangul can come back decomposed on some
// browsers/OSes, which would otherwise silently fail every comparison),
// strips whitespace/punctuation the recognizer sometimes appends, and
// removes stray sentence-ending marks.
function normalizeHeard(str) {
  return (str || '')
    .normalize('NFC')
    .trim()
    .replace(/[.!?~,·"'`]/g, '')
    .replace(/\s+/g, '');
}

function isLatinOnly(str) {
  return /^[a-zA-Z\-']+$/.test(str);
}

// Jamo pairs that Korean speech recognizers (and non-native accents)
// frequently confuse with one another. A near-miss on one of these costs
// less than a genuinely different sound, so a foreign learner's close-but-
// imperfect attempt isn't scored identically to a completely wrong one.
//
// Costs are split into two tiers instead of one flat guess-per-pair list:
//  - VOWEL/CONSONANT costs below are tuned against documented L2-Korean
//    error patterns (monophthong mergers, aspiration/tensification, and
//    liquid/nasal confusion are the most common categories for non-native
//    speakers) rather than a single undifferentiated 0.5 for "similar-ish".
//  - A separate, smaller BATCHIM (final-consonant) table exists because
//    Korean neutralizes most final consonants to one of only 7 released
//    sounds (ㄱ/ㄴ/ㄷ/ㄹ/ㅁ/ㅂ/ㅇ) in speech — e.g. final ㅅ, ㅈ, ㅊ, ㅌ, ㅎ
//    all surface as [ㄷ] — so STT engines and even careful learners very
//    often produce a phonetically-correct-sounding final consonant that
//    doesn't match the underlying spelled jamo. Penalizing that as hard as
//    a genuine mispronunciation was unfairly dragging scores down.
const JAMO_CONFUSION_PAIRS = [
  // Monophthong mergers — ㅐ/ㅔ is now near-total in Seoul Korean and
  // shouldn't really cost much at all; ㅚ/ㅞ/ㅙ have similarly collapsed
  // for most speakers, native and learner alike.
  ['ㅐ','ㅔ',0.15], ['ㅚ','ㅞ',0.3], ['ㅙ','ㅞ',0.3], ['ㅚ','ㅙ',0.3], ['ㅟ','ㅣ',0.45],
  // Rounding/backness confusions common for English/Spanish/Arabic L1
  // speakers who don't natively distinguish these vowel heights.
  ['ㅓ','ㅗ',0.55], ['ㅜ','ㅡ',0.5], ['ㅕ','ㅛ',0.55], ['ㅏ','ㅓ',0.65],
  // Lenis/aspirated pairs (ㄱ/ㅋ, ㄷ/ㅌ, ㅂ/ㅍ, ㅈ/ㅊ) — aspiration timing
  // is one of the hardest contrasts for learners without a VOT distinction
  // in their L1, so these stay fairly cheap.
  ['ㄱ','ㅋ',0.45], ['ㄷ','ㅌ',0.45], ['ㅂ','ㅍ',0.45], ['ㅈ','ㅊ',0.45],
  // Lenis/tensed (fortis) pairs — the ㅅ/ㅆ contrast in particular is
  // notoriously under-distinguished by STT acoustic models, not just
  // learners, so it gets the lowest cost in this group.
  ['ㄱ','ㄲ',0.5], ['ㄷ','ㄸ',0.5], ['ㅂ','ㅃ',0.5], ['ㅈ','ㅉ',0.5], ['ㅅ','ㅆ',0.3],
  // Liquid/nasal — ㄹ/ㄴ confusion is extremely common for L1 speakers
  // whose language doesn't have an alveolar-tap ㄹ (e.g. many English
  // speakers hear it as either 'l' or 'r' inconsistently).
  ['ㄹ','ㄴ',0.55],
  // ㅁ/ㅂ and ㅈ/ㅅ show up often enough in learner STT logs to be worth
  // a discount rather than falling through to the default cost of 1.
  ['ㅁ','ㅂ',0.7], ['ㅈ','ㅅ',0.65]
];
const JAMO_CONFUSION_MAP = {};
JAMO_CONFUSION_PAIRS.forEach(([a, b, cost]) => {
  JAMO_CONFUSION_MAP[a + '|' + b] = cost;
  JAMO_CONFUSION_MAP[b + '|' + a] = cost;
});

// Final-consonant (batchim) neutralization groups: in actual spoken Korean
// these all release as the same sound, so mixing them up isn't really a
// pronunciation error at all — it's the recognizer (or the learner) doing
// exactly what a native speaker's mouth does. Kept separate from the general
// consonant-confusion table above because it only applies in final position,
// not when the same jamo appears as an initial consonant.
const BATCHIM_NEUTRALIZATION_GROUPS = [
  ['ㄷ','ㅅ','ㅈ','ㅊ','ㅌ','ㅎ'], // all surface as released [t]
  ['ㄱ','ㅋ','ㄲ'],               // all surface as released [k]
  ['ㅂ','ㅍ'],                    // all surface as released [p]
];
const BATCHIM_NEUTRALIZATION_MAP = {};
BATCHIM_NEUTRALIZATION_GROUPS.forEach(group => {
  group.forEach(a => group.forEach(b => {
    if (a !== b) BATCHIM_NEUTRALIZATION_MAP[a + '|' + b] = 0.2;
  }));
});

function jamoSubCost(a, b, isFinalConsonant) {
  if (a === b) return 0;
  if (isFinalConsonant) {
    const neutralCost = BATCHIM_NEUTRALIZATION_MAP[a + '|' + b];
    if (neutralCost !== undefined) return neutralCost;
  }
  const cost = JAMO_CONFUSION_MAP[a + '|' + b];
  return cost !== undefined ? cost : 1;
}

// Weighted edit distance — tolerant to inserted/dropped/misaligned jamo
// (common with speech-recognition output, e.g. a trailing particle or a
// dropped final consonant) and to the sound-confusion pairs above. Plain
// unweighted Levenshtein used to treat every mismatch as equally wrong,
// which punished common near-miss STT errors as harshly as a totally
// different pronunciation.
function weightedJamoDistance(a, b) {
  const m = a.length, n = b.length;
  if (m === 0) return n;
  if (n === 0) return m;
  const dp = Array.from({ length: m + 1 }, () => new Array(n + 1).fill(0));
  for (let i = 0; i <= m; i++) dp[i][0] = i;
  for (let j = 0; j <= n; j++) dp[0][j] = j;
  for (let i = 1; i <= m; i++) {
    for (let j = 1; j <= n; j++) {
      const left = a[i - 1], right = b[j - 1];
      // Only treat this as a "final consonant" substitution when both
      // sides are actually in final position — a jong-vs-cho mismatch
      // (e.g. an inserted/dropped syllable shifting alignment) should
      // still cost the normal amount, not get the batchim discount.
      const isFinalConsonant = left.isJong && right.isJong;
      dp[i][j] = Math.min(
        dp[i - 1][j] + 1,
        dp[i][j - 1] + 1,
        dp[i - 1][j - 1] + jamoSubCost(left.ch, right.ch, isFinalConsonant)
      );
    }
  }
  return dp[m][n];
}

// Plain (unweighted) edit distance, kept for comparing romanized text
// (see the Latin-script fallback in similarityScore below).
function levenshtein(a, b) {
  const m = a.length, n = b.length;
  if (m === 0) return n;
  if (n === 0) return m;
  const dp = new Array(n + 1);
  for (let j = 0; j <= n; j++) dp[j] = j;
  for (let i = 1; i <= m; i++) {
    let prev = dp[0];
    dp[0] = i;
    for (let j = 1; j <= n; j++) {
      const temp = dp[j];
      dp[j] = a[i - 1] === b[j - 1] ? prev : 1 + Math.min(prev, dp[j], dp[j - 1]);
      prev = temp;
    }
  }
  return dp[n];
}

function similarityScore(target, heard, targetRomaja) {
  const cleanHeard = normalizeHeard(heard);
  if (!cleanHeard) return 0;

  // Occasionally the recognizer returns a romanized guess instead of Hangul
  // (e.g. it briefly loses the ko-KR language lock). Fall back to comparing
  // against the term's romanization rather than scoring it as 0% automatically.
  if (targetRomaja && isLatinOnly(cleanHeard)) {
    const a = targetRomaja.toLowerCase().replace(/[^a-z]/g, '');
    const b = cleanHeard.toLowerCase().replace(/[^a-z]/g, '');
    if (!a || !b) return 0;
    const distance = levenshtein([...a], [...b]);
    const maxLen = Math.max(a.length, b.length);
    return Math.max(0, Math.min(100, Math.round((1 - distance / maxLen) * 100)));
  }

  const targetJamo = decomposeToJamo(target);
  const heardJamo = decomposeToJamo(cleanHeard);
  if (targetJamo.length === 0) return 0;
  if (heardJamo.length === 0) return 0;

  const distance = weightedJamoDistance(targetJamo, heardJamo);
  const maxLen = Math.max(targetJamo.length, heardJamo.length);
  const score = Math.round((1 - distance / maxLen) * 100);
  return Math.max(0, Math.min(100, score));
}

// ---------- Speech recognition ----------
const micBtn = document.getElementById('micBtn');
let recognition = null;
const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
const SpeechGrammarList = window.SpeechGrammarList || window.webkitSpeechGrammarList;

// JSGF grammar built from every term in TERMS. Chrome's webkitSpeechRecognition
// only partially supports SpeechGrammarList (it nudges the language model
// toward these words rather than hard-restricting to them), but even a soft
// bias measurably reduces the recognizer guessing an unrelated real word
// instead of the close-but-imperfect Taekwondo term the student actually said.
function buildTermGrammar() {
  const words = Array.from(new Set(TERMS.map(t => t.hangul)))
    .map(w => w.replace(/"/g, ''));
  const alternation = words.join(' | ');
  return `#JSGF V1.0; grammar tkdTerms; public <term> = ${alternation};`;
}

if (SpeechRecognition) {
  recognition = new SpeechRecognition();
  recognition.lang = 'ko-KR';
  recognition.interimResults = false;
  recognition.continuous = false;
  // Chrome does not document a hard ceiling for maxAlternatives, but in
  // practice it stops returning additional distinct alternatives well
  // before 10, so 10 is a safe "give me everything you've got" value —
  // asking for more than the engine can produce is harmless, it just
  // returns fewer. More candidates means more chances that the one
  // alternative that actually matches the student's real pronunciation
  // survives into the scoring step instead of being discarded upstream.
  recognition.maxAlternatives = 10;

  if (SpeechGrammarList) {
    try {
      const grammarList = new SpeechGrammarList();
      // Weight 1 = as strong a bias toward this vocabulary as the API allows.
      grammarList.addFromString(buildTermGrammar(), 1);
      recognition.grammars = grammarList;
    } catch (e) {
      // Grammar hints are a best-effort improvement; if the browser's
      // implementation rejects the grammar string, recognition should
      // still work normally without it.
    }
  }

  recognition.onstart = () => {
    micBtn.classList.add('listening');
    micBtn.title = UI.micStopTitle[currentLang];
    micState = 'listening';
    renderMicStatus();
    // Failsafe: some browsers/mics never fire onend if audio input glitches.
    // Force a stop after a few seconds so the mic can't get stuck "on".
    clearTimeout(recognitionTimeoutId);
    recognitionTimeoutId = setTimeout(() => {
      try { recognition.stop(); } catch (e) { /* already stopped */ }
    }, RECOGNITION_TIMEOUT_MS);
  };

  // Some browsers keep the mic open briefly after the person stops
  // talking; explicitly stopping here closes it immediately instead of
  // waiting on the browser's own silence-detection timeout.
  recognition.onspeechend = () => {
    try { recognition.stop(); } catch (e) { /* already stopped */ }
  };

  recognition.onerror = (e) => {
    clearTimeout(recognitionTimeoutId);
    micBtn.classList.remove('listening');
    micBtn.title = UI.micStartTitle[currentLang];
    micState = 'error';
    micErrorCode = e.error;
    renderMicStatus();
  };

  // Some browsers fire 'nomatch' (instead of a result with empty
  // transcripts) when audio came through but nothing could be transcribed.
  // Without this, the mic would silently reset to "default" with no
  // feedback at all, which looked like the button hadn't worked.
  recognition.onnomatch = () => {
    clearTimeout(recognitionTimeoutId);
    micBtn.classList.remove('listening');
    micBtn.title = UI.micStartTitle[currentLang];
    micState = 'error';
    micErrorCode = 'no-speech';
    renderMicStatus();
  };

  recognition.onend = () => {
    clearTimeout(recognitionTimeoutId);
    micBtn.classList.remove('listening');
    micBtn.title = UI.micStartTitle[currentLang];
    // If recognition ended without ever producing a result (e.g. the
    // timeout fired, or the browser gave up silently), don't leave the
    // status stuck on "listening...".
    if (micState === 'listening') {
      micState = 'default';
      renderMicStatus();
    }
  };

  recognition.onresult = (event) => {
    const alternatives = [];
    for (let i = 0; i < event.results[0].length; i++) {
      alternatives.push({
        transcript: event.results[0][i].transcript,
        confidence: event.results[0][i].confidence || 0
      });
    }
    handleResult(alternatives);
  };
} else {
  micBtn.disabled = true;
  micBtn.style.opacity = 0.4;
  micState = 'error';
  micErrorCode = 'unsupported-browser';
}

micBtn.addEventListener('click', () => {
  if (!recognition) return;

  // Tapping while listening now acts as an explicit STOP button, instead
  // of silently failing (which used to leave the mic running with no way
  // to turn it off from the UI).
  if (micState === 'listening') {
    try { recognition.stop(); } catch (e) { /* already stopped */ }
    return;
  }

  document.getElementById('feedbackBlock').innerHTML = `<span class="empty-note"><bdi>${UI.feedbackPlaceholder[currentLang]}</bdi></span>`;
  try {
    recognition.start();
  } catch (e) {
    // Recognition thought it was already running (a stuck state from a
    // previous session) — force it to reset instead of leaving the mic
    // silently unresponsive.
    try { recognition.abort(); } catch (e2) { /* ignore */ }
    micState = 'default';
    renderMicStatus();
  }
});

async function handleResult(alternatives) {
  // Backward-compatible: accept either the new {transcript, confidence}
  // objects or plain strings.
  const heardList = (Array.isArray(alternatives) ? alternatives : [alternatives])
    .map(a => (typeof a === 'string' ? { transcript: a, confidence: 0 } : a));

  let best = { heard: heardList[0] ? heardList[0].transcript : '', score: -1, confidence: 0 };
  for (const h of heardList) {
    const s = similarityScore(currentTerm.hangul, h.transcript, currentTerm.romaja);
    // Higher score wins; on a tie, prefer the alternative the recognizer
    // itself was more confident about.
    if (s > best.score || (s === best.score && h.confidence > best.confidence)) {
      best = { heard: h.transcript, score: s, confidence: h.confidence };
    }
  }

  document.getElementById('heardText').textContent = best.heard;
  document.getElementById('heardText').classList.remove('empty-note');
  micState = 'done';
  renderMicStatus();

  updateScore(best.score);

  await fetchAiFeedback(currentTerm, best.heard, best.score);
}

// ---------- 백엔드 서버 연동 로직 (수정됨) ----------
async function fetchAiFeedback(term, heard, score) {
  const feedbackEl = document.getElementById('feedbackBlock');
  feedbackEl.className = 'feedback-block loading';
  feedbackEl.textContent = 'AI...';

  const langForPrompt = currentLang;
  const langName = LANG_NAMES[langForPrompt];

  // Pre-computed jamo-level diff (position + exact consonant/vowel swap),
  // e.g. for target "돌려차기" heard as "돌려치기": syllable 3, vowel 'ㅣ(i)'
  // -> 'ㅏ(a)'. Handing this to the model directly (instead of asking it to
  // work it out from the raw strings) grounds the feedback in an exact
  // comparison rather than an LLM guess.
  const jamoDiffs = detailedJamoDiff(term.hangul, normalizeHeard(heard));
  const jamoDiffText = jamoDiffs.length
    ? jamoDiffs.map(d => d.parts.length
        ? `syllable ${d.pos} ("${d.targetChar}"): ` + d.parts.map(p =>
            `${p.part === 'jung' ? 'vowel' : p.part === 'jong' ? 'final consonant' : 'starting consonant'} — you said '${p.heard}' (${p.heardRoman}), target is '${p.target}' (${p.targetRoman})`
          ).join('; ')
        : `syllable ${d.pos}: expected "${d.targetChar}", heard "${d.heardChar}"`
      ).join(' | ')
    : 'none detected (lengths differ or already an exact match)';

  const prompt = `You are an AI coach helping a foreign Taekwondo student correct their Korean pronunciation. Assume the student cannot read Hangul fluently, so describe sounds phonetically rather than just repeating the Korean letters.
Target term: "${term.hangul}" (romanization: ${term.romaja}, meaning: ${term.gloss.en})
Speech-recognized attempt: "${heard}"
Similarity score: ${score} out of 100
Detected sound differences (syllable position + exact consonant/vowel swap, already computed — use these instead of re-deriving them yourself): ${jamoDiffText}

Write 3-4 short, encouraging sentences of pronunciation feedback in ${langName}. You must:
1. For each detected difference above, name the exact syllable position (e.g. "the 3rd syllable") and the exact sound swap using the format 'change X to Y' (e.g. "change the 'i' sound to 'a'", or "change 'ㅣ' to 'ㅏ'") — do not just say "your pronunciation was a bit different," always name the specific syllable number and the specific sound to fix.
2. Give one concrete articulation tip a total beginner can follow — mouth/tongue position, vowel length, or which consonant to soften or harden.
3. Close with a short, warm, encouraging line, like a real instructor coaching in person.
Output only the feedback text, nothing else, and write it entirely in ${langName}.`;

  try {
    // 보안이 적용된 백엔드 서버로 프롬프트 전송
    // NOTE: this points at a LOCAL backend (localhost:3000). It only works
    // if the person running this page also has that backend running on
    // their own machine — otherwise the fetch below fails and the app
    // automatically falls back to buildFallbackFeedback() further down.
    // To give every visitor real AI feedback (not just the fallback text),
    // deploy a small backend that proxies this prompt to the Claude API
    // and update the URL here to point at it.
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 6000);
    const response = await fetch("http://localhost:3000/api/feedback", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ prompt: prompt }),
      signal: controller.signal
    });
    clearTimeout(timeoutId);

    const data = await response.json();
    const text = (data.content || [])
      .map(block => block.type === 'text' ? block.text : '')
      .join('\n')
      .trim();

    feedbackEl.className = 'feedback-block';
    feedbackEl.innerHTML = `<bdi>${text || buildFallbackFeedback(term, heard, score)}</bdi>`;
  } catch (err) {
    feedbackEl.className = 'feedback-block';
    feedbackEl.innerHTML = `<bdi>${buildFallbackFeedback(term, heard, score)}</bdi>`;
  }
}

function buildFallbackFeedback(term, heard, score) {
  const templates = FALLBACK_TEMPLATES[currentLang] || FALLBACK_TEMPLATES.en;
  if (score >= 90) return templates.high(term);
  const hint = buildJamoHint(currentLang, term.hangul, normalizeHeard(heard));
  if (score >= 60) return templates.mid(term, hint);
  return templates.low(term, hint);
}

// init
renderIntroText();
renderTarget();
document.getElementById('scoreLabel').textContent = UI.accuracyLabel[currentLang];
document.getElementById('heardLabel').textContent = UI.heardLabel[currentLang];
updateScore(0, false);
renderMicStatus();
</script>
