// ---------- Native audio playback / Korean text-to-speech (발음 듣기) ----------
// Browser TTS is a stand-in, not a substitute for a real native speaker.
// To swap in an actual recording for any term, just add an `audioUrl` field
// to that term's entry in TERMS, e.g.:
//   { cat: "balgisul", hangul: "돌려차기", romaja: "Dollyeochagi",
//     audioUrl: "audio/dollyeochagi.mp3", ... }
// If audioUrl is present, it plays instead of the synthesized voice; if it's
// missing or fails to load, the app automatically falls back to TTS below.
let cachedVoices = [];
let ttsWarmedUp = false;
function loadVoices() {
  if ('speechSynthesis' in window) cachedVoices = window.speechSynthesis.getVoices();
}
if ('speechSynthesis' in window) {
  loadVoices();

  // Chrome/Edge quirk: the very first utterance after page load is often
  // clipped at the start or renders in a flatter, more robotic cadence,
  // because the underlying synthesis engine hasn't spun up yet. Firing one
  // silent, near-instant utterance as soon as voices are available "warms"
  // the engine so the first real playback the user hears sounds the same
  // as every subsequent one, instead of being the worst-sounding one.
  const warmUp = () => {
    if (ttsWarmedUp || !cachedVoices.length) return;
    ttsWarmedUp = true;
    const silent = new SpeechSynthesisUtterance(' ');
    silent.volume = 0;
    silent.rate = 10;
    window.speechSynthesis.speak(silent);
  };
  window.speechSynthesis.onvoiceschanged = () => { loadVoices(); warmUp(); };
  warmUp();
}

function pickBestKoreanVoice() {
  // Ranked from most to least natural-sounding. Cloud/neural voices
  // (Google, Microsoft's "Online (Natural)", Apple's enhanced "Yuna" on
  // macOS/iOS) render prosody and coarticulation far more smoothly than
  // the low-fidelity offline OS default, so we actively search for those
  // by name rather than just taking whatever ko-KR voice the browser
  // happens to list first.
  const byLang = cachedVoices.filter(v => v.lang === 'ko-KR' || (v.lang && v.lang.startsWith('ko')));

  // The Web Speech API exposes no standard "gender" field on a voice, so a
  // male voice can only be requested by matching known male Korean voice
  // names shipped by each platform (e.g. Windows/Edge's "InJoon", macOS's
  // "Minsu" where available). Most Chrome installs only expose a single
  // female "Google 한국어" voice with no male alternative at all — in that
  // case there is no real male voice to select from and speakTTS() falls
  // back to lowering the pitch as an approximation (see below).
  const maleNamed = byLang.find(v => /injoon|in-joon|minsu|min-su|male/i.test(v.name));
  if (maleNamed) return maleNamed;

  return byLang.find(v => /google/i.test(v.name))
    || byLang.find(v => /neural|natural/i.test(v.name))
    || byLang.find(v => /yuna/i.test(v.name))
    || byLang.find(v => /online/i.test(v.name))
    || byLang.find(v => !v.localService)
    || byLang[0];
}

function speakTTS(hangulText, btnEl) {
  if (!('speechSynthesis' in window)) {
    alert('이 브라우저는 음성 합성을 지원하지 않습니다. (This browser does not support speech synthesis.)');
    if (btnEl) btnEl.classList.remove('speaking');
    return;
  }
  window.speechSynthesis.cancel();

  const koVoice = pickBestKoreanVoice();
  const isMaleNamed = koVoice && /injoon|in-joon|minsu|min-su|male/i.test(koVoice.name);
  const pitch = isMaleNamed ? 1 : 0.9;

  const utter = new SpeechSynthesisUtterance(hangulText);
  utter.lang = 'ko-KR';
  utter.rate = 0.99;
  utter.pitch = pitch;
  utter.volume = 1;
  if (koVoice) utter.voice = koVoice;

  utter.onend = () => { if (btnEl) btnEl.classList.remove('speaking'); };
  utter.onerror = () => { if (btnEl) btnEl.classList.remove('speaking'); };

  window.speechSynthesis.speak(utter);

  // Chrome/Edge occasionally auto-pause the synthesis queue in the
  // background tab-throttling logic, which can make an utterance stall
  // partway through and sound unnaturally cut off. A quick resume()
  // right after speak() is a known no-cost workaround.
  window.speechSynthesis.resume();
}


function speak(term, btnEl) {
  document.querySelectorAll('.speak-btn.speaking, .speak-btn-lg.speaking')
    .forEach(b => b.classList.remove('speaking'));
  if (btnEl) btnEl.classList.add('speaking');

  if (term && term.audioUrl) {
    const audio = new Audio(term.audioUrl);
    audio.onended = () => { if (btnEl) btnEl.classList.remove('speaking'); };
    audio.onerror = () => speakTTS(term.hangul, btnEl); // recording missing/broken → fall back to TTS
    audio.play().catch(() => speakTTS(term.hangul, btnEl));
    return;
  }
  speakTTS(term.hangul, btnEl);
}

document.getElementById('targetSpeakBtn').addEventListener('click', (e) => {
  speak(currentTerm, e.currentTarget);
});

function resetResult() {
  if (recognition && micState === 'listening') {
    try { recognition.stop(); } catch (e) { /* already stopped */ }
  }
  hasAttempted = false;
  lastScore = 0;
  micState = 'default';
  document.getElementById('heardText').textContent = UI.notTried[currentLang];
  document.getElementById('heardText').classList.add('empty-note');
  document.getElementById('feedbackBlock').innerHTML = `<span class="empty-note"><bdi>${UI.feedbackPlaceholder[currentLang]}</bdi></span>`;
  updateScore(0, false);
  renderMicStatus();
}

function renderMicStatus() {
  const el = document.getElementById('micStatus');
  if (micState === 'default') el.textContent = UI.micDefault[currentLang];
  else if (micState === 'listening') el.textContent = UI.micListening[currentLang];
  else if (micState === 'done') el.textContent = UI.micDone[currentLang];
  else if (micState === 'error') el.textContent = UI.micErrorPrefix[currentLang] + micErrorCode + UI.micErrorSuffix[currentLang];
}

