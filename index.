function categoryTitleHTML(key) {
  const c = CATEGORIES[key];
  if (currentLang === 'ko') return c.ko;
  return `${c.ko} (<bdi>${c[currentLang]}</bdi>)`;
}

catKeys.forEach(key => {
  const block = document.createElement('div');
  block.className = 'category-block';
  block.dataset.catKey = key;

  const title = document.createElement('div');
  title.className = 'category-title';
  title.innerHTML = categoryTitleHTML(key);
  block.appendChild(title);

  const grid = document.createElement('div');
  grid.className = 'term-grid';

  TERMS.filter(t => t.cat === key).forEach(t => {
    const idx = TERMS.indexOf(t);
    const card = document.createElement('div');
    card.className = 'term-card' + (t === currentTerm ? ' active' : '');
    card.dataset.termIdx = idx;
    card.innerHTML = `
      <div class="term-card-top">
        <div class="term-hangul">${t.hangul}</div>
        <button class="speak-btn" data-speak-idx="${idx}" title="${UI.speakTitle[currentLang]}">🔊</button>
      </div>
      <div class="term-romaja">${t.romaja}</div>
      <div class="term-gloss" data-gloss><bdi>${t.gloss[currentLang]}</bdi></div>
    `;
    card.addEventListener('click', () => selectTerm(t, card));
    card.querySelector('[data-speak-idx]').addEventListener('click', (e) => {
      e.stopPropagation();
      speak(t, e.currentTarget);
    });
    grid.appendChild(card);
  });

  block.appendChild(grid);
  container.appendChild(block);
});

